# Copy to .env in this directory, then run: docker-compose up --build -d

# --- Required ---------------------------------------------------------------
# Signs local JWTs. The backend will not start without it.
# Generate with: openssl rand -hex 32
SECRET_KEY=

# --- LLM providers (optional; an offline fallback synthesizer is built in) ---
# Gemini is preferred when both are set.
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Document parsing (optional; falls back to pypdf / python-docx) ---------
LLAMAPARSE_API_KEY=

# --- Web search (optional; without it, no web results are added) ------------
TAVILY_API_KEY=

# --- Google sign-in (optional) ----------------------------------------------
# When set, the backend checks that the Google id_token's `aud` matches it.
GOOGLE_CLIENT_ID=

# --- Overrides --------------------------------------------------------------
# docker-compose already wires POSTGRES_*, REDIS_URL and QDRANT_URL for the
# container network. Set these only when running the backend outside Docker.
# POSTGRES_SERVER=localhost
# REDIS_URL=redis://localhost:6379/0
# QDRANT_URL=http://localhost:6333

# CORS origins allowed to call the API, as a JSON array. Add your deployed
# frontend origin here, e.g. ["http://localhost:3000","https://your-app.vercel.app"]
# BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Frontend (build-time; NEXT_PUBLIC_* are inlined into the client bundle) -
# These are read from THIS file only by docker-compose, which passes them as
# build args. For native `npm run dev` they come from frontend/.env.local
# instead - Next.js loads env files relative to the frontend directory.
# Public origin of the deployment, used for canonical URLs, robots and sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where the browser reaches the API.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Google Analytics measurement ID. Leave blank to disable analytics entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Neon Auth (optional; only needed if you use the /api/auth route) -------
# Both are required together - the route refuses to serve with a default
# cookie secret rather than signing cookies with a value committed to the repo.
# Leave unset to authenticate against the backend's own /auth/login instead.
# NEXT_PUBLIC_NEON_AUTH_BASE_URL=
# NEON_AUTH_COOKIE_SECRET=

# --- Models (defaults shown; override to swap models) -----------------------
# EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
# EMBEDDING_DIM=1024                # must match EMBEDDING_MODEL
# RERANKER_MODEL=BAAI/bge-reranker-base
# OPENAI_MODEL=gpt-4o
# GEMINI_MODEL=gemini-3.5-flash   # must support streaming; 1.5/2.5-flash are retired

# --- Retrieval tuning -------------------------------------------------------
# RETRIEVAL_TOP_K=15                # candidates per retriever before fusion
# RERANK_TOP_N=5                    # chunks kept after reranking
# RERANK_SCORE_THRESHOLD=0.05       # min rerank score shown to the LLM
# Note: the cross-encoder emits low sigmoid scores. A high threshold silently
# discards chunks that do answer the question - tune against your own corpus.

# --- Ingestion / limits -----------------------------------------------------
# MAX_UPLOAD_SIZE_MB=50
# DEFAULT_CHUNK_SIZE=1000
# DEFAULT_CHUNK_OVERLAP=200
# Uploads are staged in Redis for the Celery worker, which deletes each one
# the moment it takes it. The TTL only cleans up jobs no worker picks up.
# DOC_HANDOVER_TTL_SECONDS=3600
# CELERY_RESULT_EXPIRES_SECONDS=3600

# --- Semantic answer cache (Redis) ------------------------------------------
# ANSWER_CACHE_ENABLED=true
# ANSWER_CACHE_SIMILARITY=0.95       # cosine needed to reuse an answer
# ANSWER_CACHE_MIN_CONFIDENCE=60     # only judged, confident answers are stored
# ANSWER_CACHE_TTL_SECONDS=86400
# RATE_LIMIT=100/minute

# --- Vector store -----------------------------------------------------------
# docker-compose points QDRANT_URL at the bundled container. Set these to use
# a managed cluster instead - needed for any deployment where the backend and
# Qdrant are not on the same machine.
# QDRANT_URL=https://<cluster-id>.<region>.aws.cloud.qdrant.io
# QDRANT_API_KEY=
# Free Qdrant Cloud clusters are suspended after a week idle and deleted after
# four. .github/workflows/keepalive.yml pings the cluster to prevent the first;
# if it is ever deleted anyway, the backend rebuilds the collection from the
# chunks in Postgres on its next start, so nothing is lost but time.
