# Copy to .env.local for native `npm run dev`. Every value here has a working
# localhost default, so you only need this file to point at something else.
#
# Running via docker-compose instead? These are passed as build args from the
# REPO-ROOT .env, not from this file - see the root .env.example.

# Where the browser reaches the API.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Public origin of the deployment, used for canonical URLs, robots and sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics measurement ID. Leave blank to disable analytics entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Neon Auth (optional) ---------------------------------------------------
# Only needed if you use the /api/auth/[...path] route. This app can instead
# authenticate against the backend's own /auth/login, in which case leave these
# unset - the route then fails on request, not at build time.
# NEXT_PUBLIC_NEON_AUTH_BASE_URL=
# NEON_AUTH_COOKIE_SECRET=
